# Working notes for this project — the idea, the plan, the per-issue logs. Never committed.
issues

.env

# Deploy build byproduct (see .github/workflows/deploy.yml)
build/

docker/volumes/postgres_data/**
docker/volumes/php_home/**
docker/volumes/node_home/**
# Holds the Android debug keystore, which is a key: kept out of git, but kept across builds
# (docker-compose.yml, service `capacitor`) so the debug APK's fingerprint does not change.
docker/volumes/android_home/**
!docker/volumes/**/.gitkeep

# The signing keys live outside the repo (Makefile `KEYSTORE`), so this matches nothing
# today. It is here for the day somebody copies one in "just to try it".
*.jks
*.keystore
