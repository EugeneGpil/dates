# Ports. Offset from shopping_list's (8000/8080/5432/9200) so both projects can
# be up at once; 8084 rather than 8081 for the front only because 8081-8083 were
# already taken on the machine this was set up on.
NGINX_PORT=8001
NGINX_FRONT_PORT=8084
DB_PORT=5433
QUASAR_PORT=9201

# Database
DB_DATABASE=dates
DB_USERNAME=dates
DB_PASSWORD=secret

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:9201
