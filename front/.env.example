VITE_API_URL=

# The Firebase web app config — Project settings → General → Your apps → Web app in the
# console. None of it is secret: it identifies the project to Google and ships inside every
# client. What protects the data is the id token exchange on the server (docs/firebase.md).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
